{
  "name": "rootrouter-monorepo",
  "version": "0.1.1",
  "private": true,
  "description": "RootRouter monorepo: SDK, dashboard, contracts",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w rootrouter",
    "mcp:build": "npm run build -w @rootrouter/mcp",
    "mcp:start": "npm run start -w @rootrouter/mcp",
    "demo:basic": "npm run demo:basic -w rootrouter",
    "demo:swarm": "npm run demo:swarm -w rootrouter",
    "demo:benchmark": "npm run demo:benchmark -w rootrouter",
    "test": "npm run test -w rootrouter",
    "deploy:contract": "npm run deploy:contract -w rootrouter",
    "dashboard": "npm run dev -w @rootrouter/dashboard",
    "dashboard:build": "npm run build -w @rootrouter/dashboard",
    "dashboard:start": "npm run start -w @rootrouter/dashboard"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Motus-DAO/RootRouter.git"
  },
  "author": "Gerry Alvarez <gerry@motusdao.org>",
  "license": "MIT"
}
