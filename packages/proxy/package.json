{
  "name": "@rootrouter/proxy",
  "version": "0.2.0-beta.1",
  "description": "Transparent OpenAI-compatible proxy that trims prompt context with RootRouter before forwarding upstream. Point any agent's base_url at it to cut tokens with zero code changes.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "rootrouter-proxy": "dist/server.js"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE", "COMMERCIAL.md", "BETA.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/sync-legal.mjs && npm run build",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx test/filter.test.ts && tsx test/stateful.test.ts && tsx test/lightweightRouter.test.ts",
    "test:e2e": "node test/e2e.mjs && node test/e2e-stateful.mjs"
  },
  "keywords": ["openai-proxy", "llm-proxy", "rootrouter", "context-selection", "token-reduction", "ai-agents"],
  "author": "Gerry Alvarez <gerry@motusdao.org>",
  "license": "MIT",
  "dependencies": {
    "rootrouter": "^0.2.0-beta.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RootRouter/RootRouter.git",
    "directory": "packages/proxy"
  },
  "homepage": "https://github.com/RootRouter/RootRouter#readme",
  "bugs": "https://github.com/RootRouter/RootRouter/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
