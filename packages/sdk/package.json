{
  "name": "rootrouter",
  "version": "0.2.0-beta.0",
  "description": "Algebraic agent infrastructure for AI swarms on Celo — root-pair telemetry, interaction graphs, symmetry-aware routing, and context selection",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rootrouter": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "templates", "README.md", "LICENSE", "NOTICE", "COMMERCIAL.md", "BETA.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/sync-legal.mjs && npm run build",
    "dev": "tsx watch src/index.ts",
    "demo:basic": "tsx demo/basic.ts",
    "demo:swarm": "tsx demo/swarm.ts",
    "demo:benchmark": "tsx demo/benchmark.ts",
    "demo:benchmark-live": "tsx demo/benchmark-live.ts",
    "demo:benchmark-live:session": "tsx demo/benchmark-live.ts --profile session",
    "demo:benchmark-live:basic": "tsx demo/benchmark-live.ts --profile basic",
    "demo:benchmark-live:swarm": "tsx demo/benchmark-live.ts --profile swarm",
    "demo:benchmark-live:full": "tsx demo/benchmark-live.ts --profile benchmark",
    "test": "tsx test/math.test.ts && tsx test/select.test.ts && tsx test/repo.test.ts && tsx test/models.test.ts && tsx test/benchmark.test.ts",
    "test:e2e": "tsx test/chat-pipeline.e2e.ts",
    "test:all": "npm run test && npm run test:e2e",
    "deploy:contract": "tsx scripts/deploy.ts",
    "index": "tsx src/cli/index.ts"
  },
  "keywords": ["ai-agents", "celo", "agent-infrastructure", "weyl-chambers", "openrouter", "llm", "context-filtering", "telemetry", "root-systems", "knowledge-graph"],
  "author": "Gerry Alvarez <gerry@motusdao.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RootRouter/RootRouter.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/RootRouter/RootRouter#readme",
  "bugs": "https://github.com/RootRouter/RootRouter/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "ethers": "^6.13.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "solc": "^0.8.33",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
