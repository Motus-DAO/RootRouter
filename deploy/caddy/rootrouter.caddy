# RootRouter dashboard + agent playbooks (SKILL.md, FENG-SHUI.md)
# Install: sudo cp deploy/caddy/rootrouter.caddy /etc/caddy/sites/rootrouter.caddy
#          sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# Requires rootrouter-dashboard on network openclaw_default (docker-compose.dashboard.yml).

rootrouter.motusdao.org {
	encode gzip

	# Agent playbooks — served by Next from apps/dashboard/public/
	#   /SKILL.md      Layer 1 — context routing
	#   /FENG-SHUI.md  Layer 0 — workspace placement

	reverse_proxy rootrouter-dashboard:3000
}
